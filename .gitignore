# Credentials — never commit
ebay.env

# Scanner outputs — but the canonical nightly scan result IS committed
site/data/*
*.csv
!ebay_deals.csv
!site/data/ebay_deals.csv
!site/data/history.csv
!site/data/listing_history.csv
# Marketplace board data IS committed (search deep links + watchlist): the
# push-triggered site-deploy.yml ships site/ from the checkout, so anything
# not committed 404s on the live site (marketplace.js fetches these CSVs).
!site/data/marketplace/
!site/data/marketplace/*
# Per-category deal chunks ARE committed (the site fetches them in parallel
# instead of one big CSV, so a stalled request can't blank the report).
!site/data/deals/
!site/data/deals/*

# Python
__pycache__/
*.pyc
tests/.tmp/

# Large research artifacts
buy_browse_oas3.yaml
ebay_de_category_tree.json

# OS noise
Thumbs.db
.DS_Store
