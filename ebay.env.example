# eBay API credentials — copy to ebay.env and fill in. NEVER commit ebay.env.
#
# Get keysets here: https://developer.ebay.com (create an app -> Application Keys)
# Production keyset is required for real listings; sandbox (SBX) returns test data only.
#
# Realms are auto-detected: Client ID containing "-SBX-" or Secret starting with
# "SBX-" -> sandbox endpoints (api.sandbox.ebay.com); anything else -> production.

EBAY_CLIENT_ID=your-production-client-id
EBAY_CLIENT_SECRET=your-production-client-secret

# Sandbox keyset (for plumbing tests only) — uncomment to use:
# EBAY_CLIENT_ID=your-app-SBX-xxxxxxxxxx-xxxxxxxx
# EBAY_CLIENT_SECRET=SBX-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
